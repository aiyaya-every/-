# 复制本文件为 .env 后按需修改（.env 已加入 .gitignore，不会提交真实密钥）
# 用法：cp .env.example .env  （Windows: copy .env.example .env）

# 服务端口（映射到宿主机）
PORT=3000

# 会话签名密钥。留空则应用自动生成并持久化到数据卷 data/.session-secret，
# 推荐生产/验收时显式设置一个随机串。
SESSION_SECRET=

# 采集相关：单次请求超时(毫秒) 与 请求间隔(毫秒)
COLLECT_TIMEOUT_MS=20000
REQUEST_INTERVAL_MS=500

# 智联招聘采集的关键词（逗号分隔），保证单次采集稳定凑足 >=10 条
ZHAOPIN_KEYWORDS=Java,前端,产品经理
