Type":"全职"},"date":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"今日发布"},"desc":{"description":"工作职责\n1. 负责公司移动端Web页面、H5活动页及相关业务系统前端模块的开发与迭代，保障多终端、多浏览器环境下的兼容性与流畅体验。\n2. 与产品、UI、后端开发团队紧密协作，参与需求评审与技术方案设计，完成交互逻辑落地、接口联调及上线全流程工作。\n3. 持续优化移动端页面的加载性能、交互响应速度，排查并解决前端兼容性问题、线上故障，提升用户访问体验。\n4. 沉淀前端通用组件与公共代码库，参与团队前端开发规范的制定与落地，提升整体研发交付效率。\n任职要求\n1. 大专及以上学历，计算机相关专业，具备扎实的Web前端基础。\n2. 熟练掌握HTML5、CSS3、JavaScript（ES6+）核心语法，熟悉移动端Web适配方案（rem/vw/响应式布局），了解移动端浏览器兼容性差异及调试方法。\n3. 熟练使用至少一种主流前端框架（Vue/React）及配套生态工具，具备实际移动端项目开发经验，能独立完成模块级功能开发。\n4. 了解前端工程化相关工具（Webpack/Vite等）的基本配置与使用，熟悉HTTP协议及前后端交互流程，具备良好的代码规范意识与问题排查能力。","descriptionHighlight":"","highlightLabels":[],"labels":["HTML5","CSS","JavaScript","Vue","React","移动端WEB开发","前端性能优化","前端工程化"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"9000100000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"9000100040000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[{"labelDescription":{"centerUrl":"https://img02.zhaopin.com/2012/other/mobile/capp/operation/highchannel/agentCenterImage.png?w=1005&h=420&r=3","description":"*为保证您的财产安全，不要向招聘方缴纳任何费用","subTitle":"【代招】指从事职业中介活动，依法向人力资源社会保障行政部门申请行政许可，获得《人力资源服务许可证》的企业，该类企业帮助最终用工方，进行代理招聘的相关业务。","topBackUrl":"https://img02.zhaopin.com/2012/other/mobile/capp/operation/highchannel/agentTopBack.png?w=1125&h=384&r=3","topTitleUrl":"https://img02.zhaopin.com/2012/other/mobile/capp/operation/highchannel/agentTitle.png?w=360&h=84&r=3"},"type":23,"typeName":"代招岗位","typeShowLabel":"https://img09.zhaopin.com/2012/other/mobile/capp/job/tagdaizhao.png?w=78&h=48&r=3"}],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgNam