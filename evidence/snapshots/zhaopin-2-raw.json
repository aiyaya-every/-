ureServer":null,"feedOperation":null,"feedPosition":null,"financingStage":null,"firstPublishTime":"","hasAppliedPosition":false,"industryName":"畜牧业","innerBusinessInfo":null,"internshipMonths":0,"isNewPosition":0,"jdCardType":2,"jobDetailData":{"atsAgreement":null,"company":{"base":null,"companyAuditNature":null,"companyComment":null,"companyInterview":null,"jumpDetail":null,"orgBestRanking":null,"orgReliableCompany":null,"other":null,"state":null},"companyProxy":{"companyAddress":"","companyImage":"","companyName":"","companySize":"","entryCompanyTitle":""},"customAttributeInfo":{"platformRemind":"","reportItems":[],"welfareItems":[],"workTimeItems":[]},"debug":{},"experimentInfo":{"blueCollarJobTitleExperimentInfo":null},"featureServer":null,"imSection":null,"internship":[],"live":{"liveItems":[],"liveQuickFocusChecked":0,"liveQuickFocusState":0,"recommendLiveList":[],"state":0},"operationSection":{"topJobBannerArea":{"arrowUrl":"","backgroundImage":"https://img09.zhaopin.cn/2012/other/mobile/capp/operation/highchannel/jobDetailTopBack.png?w=710&h=142&r=3","bannerType":"highSalaryJob","icon":"https://img09.zhaopin.cn/2012/other/mobile/capp/operation/highchannel/jobDetailIcon.png?w=252&h=84&r=3","link":"","pcShowTag":"https://storage-public.zhaopin.cn/zp/clouddisk/1782971298850566754/7b406799-8172-4b28-8e95-a89e1205d461.png?w=186&h=54&r=3","text":["你的价值，本该更高"],"textColor":"#FFFFFF","topIcon":""}},"partTime":[],"position":{"base":{"deliveryPath":"","education":"本科","educationCode":"","maxSalary":"","minSalary":"","positionId":40891126414,"positionName":"产品设计经理（畜牧养殖牛肉产品方向）","positionNumber":"CCL1526702740J40891126414","positionUrl":"","positionWorkingExp":"3-5年","positionWorkingExpCode":"","propertyType":"","recruitNumber":0,"salary":"7-13万","salaryReal":"","workType":"全职"},"date":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月30日发布"},"desc":{"description":"工作职责\n1. 牵头牛肉品类产品线的整体规划与全生命周期管理，深度结合畜牧养殖端的产能特点、品种优势，制定匹配不同消费场景的产品矩阵与迭代路径。\n2. 深入调研肉牛养殖全流程的品控标准、产能节奏，联动养殖、供应链、销售端团队，打通从养殖标准落地、屠宰分割规格设定到终端产品形态设计的全链路协同机制。\n3. 持续追踪牛肉消费市场趋势、竞品动态及用户反馈，挖掘细分场景需求，输出具备差异化竞争力的产品方案，明确产品定位、成本结构、定价策略及盈利模型。\n4. 主导产品落地全流程的跨部门协同，跟进产品从概念打样、小范围测试到规模上市的全节点进度，协调解决落地过程中的标准对齐、品质管控等问题，保障产品按预期交付。\n5. 建立产品上市后的效果追踪体系，结合销售数据、市场反馈持续优化产品设计，推动产品线的营收与毛利目标达成。\n任职要求\n1. 本科及以上学历，食品科学、畜牧兽医、市场营销、产品管理等相关专业优先。\n2. 拥有3年以上农牧食品领域产品设计/产品管理经验，熟悉牛肉品类特性，对肉牛养殖流程、分割标准、分级体系及上下游供应链逻辑有清晰认知。\n3. 具备独立操盘完整产品线从0到1落地的经验，能够独立完成市场调研、方案设计、跨部门协同推动及上市后复盘全流程工作。\n4. 具备敏锐的市场洞察力与用户思维，能够精准捕捉消费需求变化，输出可落地的产品创新方向。\n5. 具备优秀的跨部门沟通协调能力与项目推进能力，能有效联动养殖、生产、销售等多端团队对齐目标，推动项目落地。","descriptionHighlight":"","highlightLabels":[],"labels":["畜牧业"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"3000100000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"3000100040000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgName":"","urgentRecruitmentUrl":""},"preferredHrInfo":{"icon":"","introduce":"","jumpUrl":"","preferredHr":false},"todayInterview":null,"workLocation":{"address":"工作地点：上海 · 嘉定区","addressType":0,"latitude":"31.39961912804729","longitude":"121.1835046501636","positionCityDistrict":"","positionCityDistrictCode":"","positionCityId":"538","positionWorkCity":"","showMap":true,"showMultiAddressesTip":"","staticMapUrl":"https://storage-public.zhaopin.cn/job/share/1789118133731827348/e9f2e373b62644ae98ba649c96b213f8","streetName":"","tradingArea":"","travelMode":"bus","verifyTheTruthUrl":"","workAddress":"嘉定上海五丰上食食品有限公司11栋"}},"proxyWarning":null,"recommender":{"avatar":"","name":"","state":0,"text":"","title":""},"secure":{"abroadLabel":"","abroadTipInfo":null,"an