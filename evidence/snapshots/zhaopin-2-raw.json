风控等多方团队，推动跨部门项目落地。\n任职要求\n1. 本科及以上学历；自主学习能力强，对行业趋势有敏锐的洞察力、突出的数据驱动、结果导向和问题攻坚能力；\n2. 1-3 年平台产品或内容安全相关产品经验，熟悉审核策略，有内容安全系统、人力、绩效系统平台经验者优先；\n3. 具备扎实的产品方法论，能独立完成需求分析、方案设计、PRD 输出与项目推进；\n4. 独立负责过较大产品模块并成功交付者优先；\n5. 具备较强的责任心与独立担当能力，善于跨团队沟通协调。","descriptionHighlight":"","highlightLabels":[],"labels":["网络安全","内容安全","产品模块","需求分析","方案设计","PRD 输出与项目推进","产业互联网平台"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"3000100000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"3000100010000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgName":"","urgentRecruitmentUrl":""},"preferredHrInfo":{"icon":"","introduce":"","jumpUrl":"","preferredHr":false},"todayInterview":null,"workLocation":{"address":"工作地点：河东区 · 大王庄","addressType":0,"latitude":"39.122588932912386","longitude":"117.22193848581735","positionCityDistrict":"","positionCityDistrictCode":"","positionCityId":"531","positionWorkCity":"","showMap":true,"showMultiAddressesTip":"","staticMapUrl":"https://storage-public.zhaopin.cn/job/share/1788925871089365800/af068cba32c0449f9c8ce99e6516e175","streetName":"","tradingArea":"","travelMode":"bus","verifyTheTruthUrl":"","workAddress":"天津河东中海环宇中心-3号楼22层"}},"proxyWarning":null,"recommender":{"avatar":"","name":"","state":0,"text":"","title":""},"secure":{"abroadLabel":"","abroadTipInfo":null,"antiFraudGuide":null,"safeCenter":null,"safetyReminder":null},"staff":{"activityLevel":["高回复率"],"auditNaturePrompt":null,"authenticationState":0,"avatar":"https://storage-public.zhaopin.cn/user/avatar/1773633970091377808/vSg0MdbzQDGB0BlE6e5b35a567425e781128665c2746644e.jpg?x-oss-process=image/resize,l_240/rotate,0","companyNa