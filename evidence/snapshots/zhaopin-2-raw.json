65-43a5-add1-072ebdc8534b.png","companyName":"信必优(深圳)信息技术有限公司","companyNumber":"CZ641354530","companyRootId":0,"companyScaleTypeTagsNew":[],"companySize":"500-999人","companyUrl":"http://company.zhaopin.com/CZ641354530.htm","deliveryPath":"","displayPhoneNumber":false,"distance":0,"distanceFormat":"","distanceText":"","education":"大专","experimentInfo":null,"extend":{"calculatedDistanceInfo":null,"needGray":false},"extensions":null,"featureServer":null,"feedOperation":null,"feedPosition":null,"financingStage":null,"firstPublishTime":"","hasAppliedPosition":false,"industryName":"软件/IT服务","innerBusinessInfo":null,"internshipMonths":0,"isNewPosition":0,"jdCardType":2,"jobDetailData":{"atsAgreement":null,"company":{"base":null,"companyAuditNature":null,"companyComment":null,"companyInterview":null,"jumpDetail":null,"orgBestRanking":null,"orgReliableCompany":null,"other":null,"state":null},"companyProxy":{"companyAddress":"","companyImage":"","companyName":"","companySize":"","entryCompanyTitle":""},"customAttributeInfo":{"platformRemind":"","reportItems":[],"welfareItems":[],"workTimeItems":[]},"debug":{},"experimentInfo":{"blueCollarJobTitleExperimentInfo":null},"featureServer":null,"imSection":null,"internship":[],"live":{"liveItems":[],"liveQuickFocusChecked":0,"liveQuickFocusState":0,"recommendLiveList":[],"state":0},"operationSection":{"topJobBannerArea":null},"partTime":[],"position":{"base":{"deliveryPath":"","education":"大专","educationCode":"","maxSalary":"","minSalary":"","positionId":40892377410,"positionName":"java中级工程师【国庆到岗，线下面试】","positionNumber":"CC641354530J40892377410","positionUrl":"","positionWorkingExp":"1-3年","positionWorkingExpCode":"","propertyType":"","recruitNumber":0,"salary":"5000-6000元·13薪","salaryReal":"","workType":"全职"},"date":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月28日发布"},"desc":{"description":"工作职责\n1. 负责政务监管类平台的后端功能开发、版本迭代与模块优化，全流程参与需求评审、技术方案设计、代码实现、单元测试、联调上线各环节，确保系统功能匹配监管业务实际诉求。\n2. 围绕多级统筹管理的业务场景完成功能模块开发，支撑监管业务流程的线上化落地与高效运转。\n3. 承担系统内外部接口开发与适配工作，完成跨第三方平台的联调对接与数据互通，保障跨系统数据传输的稳定性、高效性与安全性。\n4. 参与项目技术架构优化、性能调优、代码重构与安全漏洞修复，按规范编写开发文档、接口文档及运维文档，配合完成代码评审、技术复盘与信创国产化适配工作。\n5. 协同实施、测试团队完成系统测试、问题修复、现场调试与验收交付，快速响应项目全周期的技术问题，保障项目按期顺利上线。\n6. 沉淀项目公共组件与通用工具方法论，积累政务监管领域项目开发经验，支撑团队技术能力迭代升级。\n任职要求\n1. 专科及以上学历，计算机、软件工程、大数据、电子信息等相关专业，具备2年及以上Java后端开发与项目交付经验，拥有完整企业级信息化项目交付经历，有政务监管、大数据平台开发经验者优先。\n2. 熟练掌握Java开发语言，精通SpringBoot、SpringCloud等主流微服务框架；熟练编写SQL语句，精通MySQL、Oracle数据库开发与性能优化；熟悉Redis、消息队列等中间件的使用与基础运维。\n3. 熟悉微服务架构设计模式、接口开发规范与前后端联调流程，具备独立模块开发、线上问题排查、系统性能调优的实操能力；了解大数据采集、数据同步、数据建模基础知识，熟悉信创国产化适配开发的候选人优先。\n4. 能够快速拆解业务需求并转化为可落地的技术方案，适配政务类项目的交付标准与流程要求。\n5. 具备规范的代码编写习惯，逻辑清晰，拥有良好的技术文档撰写能力与跨团队协作意识；问题攻坚能力强，能够适配项目交付节奏，可配合短期现场驻场调试，责任心强，服从项目团队统一管理。","descriptionHighlight":"","highlightLabels":[],"labels":["Spring","MySQL","Oracle","Redis","JAVA后端开发","微服务架构","政务监管平台开发"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"9000300000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"9000300110000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgName":"","urgentRecruitmentUrl":""},"preferredHrInfo":{"icon":"","introduce":"","jumpUrl":"","preferredHr":false},"todayInterview":null,"workLocation":{"address":"工作地点：双流区 · 华阳","addressType":0,"latitude":"30.51736513919235","longitude":"104.06953481048733","positionCityDistrict":"","positionCityDistrictCode":"","positionCityId":"801","positionWorkCity":"","showMap":true,"showMultiAddressesTip":"","staticMapUrl":"https://storage-public.zhaopin.cn/job/share/1790566483961016346/ab1a10f60eeb488eb5506bfcf227a491","streetName":"","tradingArea":