,"companyImage":"","companyName":"","companySize":"","entryCompanyTitle":""},"customAttributeInfo":{"platformRemind":"","reportItems":[],"welfareItems":[],"workTimeItems":[]},"debug":{},"experimentInfo":{"blueCollarJobTitleExperimentInfo":null},"featureServer":null,"imSection":null,"internship":[],"live":{"liveItems":[],"liveQuickFocusChecked":0,"liveQuickFocusState":0,"recommendLiveList":[],"state":0},"operationSection":{"topJobBannerArea":null},"partTime":[],"position":{"base":{"deliveryPath":"","education":"本科","educationCode":"","maxSalary":"","minSalary":"","positionId":40966714908,"positionName":"高级java开发工程师","positionNumber":"CCL1428616050J40966714908","positionUrl":"","positionWorkingExp":"5-10年","positionWorkingExpCode":"","propertyType":"","recruitNumber":0,"salary":"1-1.5万","salaryReal":"","workType":"全职"},"date":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月30日发布"},"desc":{"description":"岗位职责\n1. 负责公司核心产品的研发、功能迭代及维护，持续优化系统性能、稳定性和可扩展性。\n2. 参与业务需求分析，负责平台架构设计、技术选型、技术方案编写及核心模块开发，推动方案落地。\n3. 牵头解决高并发、分布式及复杂业务场景下的技术难点，快速定位并处理线上问题。\n4. 熟练运用 AI 编程工具及 Vibe Coding 工作方式，完成需求拆解、原型验证、功能开发、代码重构和测试验证，提升研发效率。\n5. 制定并优化开发规范，组织代码评审，负责代码质量及技术文档的输出和审核，确保 AI 生成代码符合项目要求。\n6. 参与测试计划和测试用例评审，组织上线准备、部署发布及上线复盘，保障交付质量。\n7. 负责研发任务拆解、进度协调和技术指导，开展团队培训与技术分享，推动 AI 辅助开发在团队中的实际应用。\n任职要求\n1. 计算机及相关专业，本科及以上学历。\n2. 具备 5 年及以上 Java 开发经验，3 年及以上项目管理及架构设计相关经验，能够独立负责核心模块开发并推动项目交付。\n3. Java 基础扎实，熟悉集合、IO、多线程及并发编程，理解 JVM 原理，具备性能分析及调优能力。\n4. 熟悉 Spring Boot、Spring MVC、MyBatis、Hibernate 等常用框架，理解核心设计原理，有源码阅读经验者优先。\n5. 参与过高并发、分布式系统架构设计，熟悉 SOA 或微服务架构，掌握缓存、消息队列及分布式事务等常用技术，能够根据业务场景合理应用。\n6. 熟悉 MySQL 等关系型数据库，理解事务、锁、索引及并发控制，具备数据库设计和 SQL 优化能力。\n7. 熟悉 Linux、Nginx、Redis 等相关环境及组件的部署、配置与调优，具备线上故障排查能力。\n8. 熟练使用 AI 编程工具，具备实际项目中的 Vibe Coding 经验，能够通过清晰的需求描述、项目上下文和多轮迭代，完成从需求到可运行功能的开发过程。\n9. 能够理解、审查和修改 AI 生成的代码，识别逻辑错误、边界条件、性能及安全问题，通过测试验证结果，对最终交付质量负责。\n10. 具备良好的软件设计、编码规范及重构能力，熟悉 Git 和团队协作流程，遵守代码及数据保密要求。\n11. 思路清晰，具备良好的沟通协调、团队管理和执行能力，能够指导团队成员解决问题并推进任务完成。\n加分项\n- 有使用 AI 编程工具完成完整项目或复杂功能交付的案例，可现场演示。\n- 有推动团队应用 AI 编程工具、沉淀开发规范及实践方法的经验。\n- 有大型系统架构优化、性能调优或重大线上故障处理经验。","descriptionHighlight":"","highlightLabels":[],"labels":["JavaScript","Python","Spring","Hibernate","Mybatis","MySQL","PostgreSQL","Redis","软件/IT服务","人工智能"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"9000300000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"9000300110000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgName":"","urgentRecruitmentUrl":""},"preferredHrInfo":{"icon":"","introduce":"","jumpUrl":"","preferredHr":false},"todayInterview":null,"workLocation":{"address":"工作地点：金水区 · 丰产路","addressType":0,"latitude":"34.78558956982171","longitude":"113.69206731422096","positionCityDistrict":"","positionCityDistrictCode":"","positionCityId":"719","positionWorkCity":"","showMap":true,"showMultiAddressesTip":"","staticMapUrl":"https://storage-public.zhaopin.cn/job/share/1789036872518956244/510ec62c853c48ee843785a88f6e6623","streetName":"","tradingArea":"","travelMode":"bus","verifyTheTruthUrl":"","workAddress":"郑州金水财富广场-1号楼6层601"}},"proxyWarning":null,"recommender":{"avatar":"","name":"","state":0,"text":"","title":""},"secure":{"abroadLabel":"","abroadTipInfo":null,"antiFraudGuide":null,"safeCenter":null,"safetyReminder":null},"staff":{"activityLevel":[],"auditNaturePrompt":null,"authenticationState":0,"avatar":"https://storage-public.zhaopin.cn/zp/clouddisk/1771900444575018357/ee67ac6c-a8f8-4018-9a56-9603e9821dde.png?x-oss-process=image/resize,l_240/rotate,0","companyName":"中科金审科技(郑州)有限公司","goldMedalInterviewer":null,"greeting":"","greetingHasDelivery":"","hrJ