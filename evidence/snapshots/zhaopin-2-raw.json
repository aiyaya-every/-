blishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月29日发布"},"desc":{"description":"岗位职责：\n熟悉Git工作流、Maven/Gradle，能编写Shell或Python脚本，了解Jenkins/GitLab CI等CI/CD流程。\n掌握内存模型、类加载机制、垃圾回收（GC）算法，能独立分析内存快照和线程快照，并进行性能优化。\n精通并发编程（JUC、AQS、锁机制）和网络编程NIO。\n精通MySQL/PostgreSQL，包括索引优化、SQL调优、事务隔离级别、锁机制。能进行分库分表设计（如ShardingSphere）。\n掌握Redis（熟练核心数据结构、持久化、主从/哨兵/集群），Elasticsearch搜索引擎，Doris等。\n精通Spring、Spring Boot框架、MyBatis 、MyBatis-plus数据库持久层框架。\n深入Spring Cloud生态（如Nacos、Gateway、OpenFeign、Sentinel），理解服务发现、配置中心、网关路由、熔断降级,远程调用等原理。\n深入理解至少一种消息队列（如RocketMQ、Kafka），掌握核心模型、高可用机制，并知道如何解决消息丢失、重复、积压、顺序消费等问题。\n熟练运用常见设计模式（如策略、模板、工厂）重构代码。\n知道如何利用Prometheus + Grafana进行监控告警，理解链路追踪（Jaeger/SkyWalking），能高效聚合检索日志（ELK/EFK）。\n具备线上问题系统性排查（CPU飙升、内存泄漏、死锁等）和性能调优能力。<div> 任职要求：</div><div> 1. 计算机科学、人工智能、信息安全、网络空间安全等相关专业本科及以上学历。 \n2. 3年以上Java开发经验</div>","descriptionHighlight":"","highlightLabels":[],"labels":["Spring","Mybatis","Redis"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"9000300000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"9000300110000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgName":"","urgentRecruitmentUrl":""},"preferredHrInfo":{"icon":"","introduce":"","jumpUrl":"","preferredHr":false},"todayInterview":null,"workLocation":{"address":"工作地点：和林格尔县 · 盛乐","addressType":0,"latitude":"40.47985917045052","longitude":"111.78669776953899","positionCityDistrict":"","positionCityDistrictCode":"","positionCityId":"587","positionWorkCity":"","showMap":true,"showMultiAddressesTip":"","staticMapUrl":"https://storage-public.zhaopin.cn/job/share/1790674689881431360/732f72a2d42d4046a31ceabdbfd755a8","streetName":"","tra