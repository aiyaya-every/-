sitionRecommendLevel":"","aiPositionRecommendReason":"","alreadyCallPhone":false,"applyType":"1","atsHumanResource":false,"campusBestCompany":null,"campusJobDetail":null,"campusJobMatchData":null,"campusPositionCardTagInfo":null,"campusRootOrgInfo":null,"canBeRegular":false,"canRemoteInternship":false,"cardCustomJson":"{\"address\":\"德阳 广汉市 金鱼镇\",\"companyName\":\"中科基创(成都)新材料\",\"locationType\":\"5\",\"publishNew\":1,\"salary60\":\"1.5-3万\"}","cardType":1,"chatWindow":1,"cityDistrict":"广汉市","cityId":"805","commercialLabel":[],"commonTrack":{"trackCommercialFeature":"","trackSocialSearchEmergencyFeature":false},"companyId":0,"companyLogo":"https://storage-public.zhaopin.cn/org/logo/1636697548713247486/Cheloat%E9%95%82%E7%A9%BA1.jpg","companyName":"中科基创(成都)新材料科技有限公司","companyNumber":"CZL1346589430","companyRootId":0,"companyScaleTypeTagsNew":[],"companySize":"20-99人","companyUrl":"http://company.zhaopin.com/CZL1346589430.htm","deliveryPath":"","displayPhoneNumber":false,"distance":0,"distanceFormat":"","distanceText":"","education":"本科","experimentInfo":null,"extend":{"calculatedDistanceInfo":null,"needGray":false},"extensions":null,"featureServer":null,"feedOperation":null,"feedPosition":null,"financingStage":null,"firstPublishTime":"","hasAppliedPosition":false,"industryName":"学术/科研","innerBusinessInfo":null,"internshipMonths":0,"isNewPosition":0,"jdCardType":2,"jobDetailData":{"atsAgreement":null,"company":{"base":null,"companyAuditNature":null,"companyComment":null,"companyInterview":null,"jumpDetail":null,"orgBestRanking":null,"orgReliableCompany":null,"other":null,"state":null},"companyProxy":{"companyAddress":"","companyImage":"","companyName":"","companySize":"","entryCompanyTitle":""},"customAttributeInfo":{"platformRemind":"","reportItems":[],"welfareItems":[],"workTimeItems":[]},"debug":{},"experimentInfo":{"blueCollarJobTitleExperimentInfo":null},"featureServer":null,"imSection":null,"internship":[],"live":{"liveItems":[],"liveQuickFocusChecked":0,"liveQuickFocusState":0,"recommendLiveList":[],"state":0},"operationSection":{"topJobBannerArea":null},"partTime":[],"position":{"base":{"deliveryPath":"","education":"本科","educationCode":"","maxSalary":"","minSalary":"","positionId":40913204713,"positionName":"FDE(AI应用工程师）","positionNumber":"CCL1346589430J40913204713","positionUrl":"","positionWorkingExp":"3-5年","positionWorkingExpCode":"","propertyType":"","recruitNumber":0,"salary":"1.5-3万","salaryReal":"","workType":"全职"},"date":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月30日发布"},"desc":{"description":"岗位职责：\n1.制定分阶段AI实施路线图，确保与公司战略目标对齐。\n2.打通钉钉、千问、OA、CRM、金蝶财务等现有系统数据设计并落地轻量级数据仓库/数据中台，建立数据治理规范，为AI应用提供高质量数据支撑；\n3.负责AI智能体开发与落地，查询、经营分析、风险预警、报表生成等场景的智能化；构建基于大模型的经营决策助手；\n4.负责深入了解集团各部门业务流程，主动识别业务痛点、低效环节及可数字化场景，将业务问题转化为产品方案、功能需求和开发任务，AI工具&智能体与各业务系统深度融合的集成方案，形成流程操作手册。\n5.负责企业内部轻量化应用的设计、开发、部署和持续迭代；\n6.AI部署与优化：负责大模型及AI算法在智能硬件终端的高效部署，开发实现管理后台、数据看板、审批、台账、巡检、报表等业务工具；\n7.负责AI智能体的搭建工作，包括模型配置、提示词工程、RAG配置、及流程编排智能问答等AI应用落地； \n8.负责现有系统的接口对接、数据同步及基础二次开发；\n9.组建并带领AI项目团队(初期可依赖外部合作+内部兼职+逐步内化)推动跨部门协作，建立AI应用的推广机制与培训体系-培养公司内部的“业务+AI”复合型人才梯队；\n10.根据实际使用反馈持续优化流程，推动应用真正落地并解决业务问题；\n11.完成各类应用环境部署、配置调优、数据接入、功能验证、数据备份、日志排查及相关技术文档编写。\n12.负责AI项目预算制定、费用管控、采购决策与投入产出闭环，定期向管理层汇报项目进展与价值成果。\n任职要求：\n1.技术能力一大模型应用方向，深入理解大模型技术原理，熟悉OpenAlI、Anthropic、DeepSeek、通过千问等主流平台API熟练掌握RAG架构（向量数据库、Embedding、重排序）、Agent框架（LangChain/Llamalndex/AutoGen等）、Prompt Engineering熟悉云基础设施（Docker/K8s），具备AWS/阿里云/腾讯云等至少一个云平台的实操经验。\n2.具备良好业务理解力，精准挖掘部门需求并转化为落地流程方案。有面向非技术人员的系统培训、需求调研或数字化推广经验，耐心配合跨部门落地迭代。\n3.具备较强的问题排查与解决能力，能独立分析和定位技术问题，具备基础脚本修改、APl调用及数据处理能力。\n4.具备良好的沟通能力和项目管理意识，学习能力强，对Al技术有热情，能快速掌握新产品和新技术，有飞书/钉钉/企业微信等平台的部署集成开发或实施经验。","descriptionHighlight":"","highlightLabels":[],"labels":["大模型","AIGC","人工智能","软件/IT服务"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"3000100000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"3000100210000","subJobTypeLev