company":{"base":null,"companyAuditNature":null,"companyComment":null,"companyInterview":null,"jumpDetail":null,"orgBestRanking":null,"orgReliableCompany":null,"other":null,"state":null},"companyProxy":{"companyAddress":"","companyImage":"","companyName":"","companySize":"","entryCompanyTitle":""},"customAttributeInfo":{"platformRemind":"","reportItems":[],"welfareItems":[],"workTimeItems":[]},"debug":{},"experimentInfo":{"blueCollarJobTitleExperimentInfo":null},"featureServer":null,"imSection":null,"internship":[],"live":{"liveItems":[],"liveQuickFocusChecked":0,"liveQuickFocusState":0,"recommendLiveList":[],"state":0},"operationSection":{"topJobBannerArea":null},"partTime":[],"position":{"base":{"deliveryPath":"","education":"本科","educationCode":"","maxSalary":"","minSalary":"","positionId":40891185414,"positionName":"研学产品销售经理","positionNumber":"CCL1524990020J40891185414","positionUrl":"","positionWorkingExp":"5-10年","positionWorkingExpCode":"","propertyType":"","recruitNumber":1,"salary":"6000-9000元","salaryReal":"","workType":"全职"},"date":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月30日发布"},"desc":{"description":"岗位职责：<div> 1.经营目标统筹：制定研学板块年度、季度、月度营收指标，拆分销售、团建、夏令营等业务业绩目标，统筹全部门完成营收任务；管控研学板块整体成本，审核课程物料、活动采购、人员薪资等预算，每月出具经营数据报表，调整定价与盈利模式。 \n2.团队管理与架构统筹：统筹管理销售拓展、课程研发、现场执行三大研学团队，制定岗位考核标准、奖惩制度、人员排班；组织部门月度工作例会，协调跨岗位工作冲突，统筹人员招聘、岗前培训、岗位晋升工作。 \n3.政企资源与资质申报：对接教育局、文旅局、科协、学校、国企工会等单位高层，维护政企核心合作资源，争取研学政策扶持；牵头申报科普教育基地、国防教育研学基地等官方资质，提升航博城研学板块官方公信力。 \n4.产品与品牌顶层规划：审定研发团队输出的航空研学课程、夏令营、团建产品，确定产品体系、定价、特色体验项目；联动展馆展厅、文创、餐饮、模拟飞行等业态，设计一体化打包研学套餐，提升客单价与综合收益；统筹航空科普公益活动、研学赛事、品牌宣传方案，打造区域航空研学标杆 IP。 \n5.业务统筹与风险管控： 统筹重大千人级研学团、政企大型团建项目，把控合作签约、活动落地、售后全流程关键节点；建立研学安全、教学、服务全流程管控标准，审核安全应急预案，处理重大客户投诉、运营突发风险；定期复盘渠道客源、课程转化、接待反馈，指导销售、研发、执行团队优化业务短板。 \n6.对内对外汇报协调：定期向展馆管理层汇报研学板块业绩、运营问题、年度发展规划，落地上级下达的经营任务；协调展馆后勤、安保、展陈等其他部门，保障研学活动场地、设备、配套资源正常供给。</div><div> \n</div><div> 任职资格：</div><div> 1.本科及以上学历，不限专业。 \n2.5 年及以上研学、科普教育、文旅团建板块全盘管理经验，不少于 3 年部门负责人岗位经历；拥有教育局、科协、学校、国企工会等政企渠道资源，熟悉研学基地、科普基地、国防教育基地申报流程。精通研学、夏令营、团建项目全链条业务，掌握课程产品研发、市场拓展及现场活动落地执行；能够独立开展经营预算编制、成本管控与经营数据分析，输出经营分析报表。熟悉研学活动安全管理规范，掌握青少年活动安全风险防控相关法规要求。有航空科普、科技馆、文博场馆研学业务全盘操盘经验优先。 \n3.认同国企管理制度，能够接受节假日、寒暑假研学高峰期工作节奏。</div>","descriptionHighlight":"","highlightLabels":[],"labels":["研学产品","研学全模块管理","研学销售","研学课程研发","博物馆研学","文旅研学","科技研学"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"3000100000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"3000100040000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgName":"","urgentRecruitmentUrl":""},"preferredHrInfo":{"icon":"","introduce":"","jumpUrl":"","preferredHr":false},"todayInterview":null,"workLocation":{"address":"工作地点：绿园区 · 城西","addressType":0,"latitude":"43.9020023319318","longitude":"125.20281822774164","positionCityDistrict":"","positionCityDistrictCode":"","positionCityId":"613","positionWorkCity":"","showMap":true,"showMultiAddressesTip":"","staticMapUrl":"https://storage-public.zhaopin.cn/job/share/1786071300430727581/5c734218a7aa4cf99828d1e8a3a1d07d","streetName":"","tradingArea":"","travelMode":"bus","verifyTheTruthUrl":"","workAddress":"绿园长春航空文化展示中心"}},"proxyWarning":null,"recommender":{"avatar":"","name":"","state":0,"text":"","title":""},"secure":{"abroadLabel":"","abroadTipInfo":null,"antiFraudGuide":null,"safeCenter":null,"safetyReminder":null},"staff":{"activityLevel":[],"auditNaturePrompt":null,"authenticationState":0,"avatar":"https://storage-public.zhaopin.cn/zp/clouddisk/1771900457683718776/1cb61361-05a5-47ec-985a-488c8461e689.png?x-oss-process=image/resize,l_240/rotate,0","companyName":"长发北亚(长春)航空博览运