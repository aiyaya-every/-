te":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月30日发布"},"desc":{"description":"**岗位职责**：\n1. 负责IaaS平台的架构设计、开发和维护，确保系统稳定、高效、安全运行。\n2. 参与云平台项目的需求分析、系统设计、开发、测试和部署等工作。\n3. 负责云平台资源的分配和管理，优化资源利用效率。\n4. 参与云平台安全架构的设计与实施，确保数据安全和系统稳定。\n5. 跟踪云技术发展趋势，持续优化和提升云平台性能。<div> \n**任职要求**： \n1. 本科及以上学历，计算机科学、软件工程等相关专业。 \n2. 3年以上IaaS平台开发经验，熟悉云平台架构设计、开发与运维。 \n3. 熟悉Linux操作系统、网络协议、存储技术等。 \n4. 熟悉主流云平台架构，如阿里云、腾讯云、华为云等。 \n5. 具备良好的编程能力，熟悉Java、Python、Shell等编程语言。</div><div> \n**加分项**： \n1. 具备云计算平台架构设计经验，熟悉虚拟化技术。 \n2. 具备开源云平台开发经验，如OpenStack、Kubernetes等。 \n3. 具备良好的团队协作能力和沟通能力。</div>","descriptionHighlight":"","highlightLabels":[],"labels":["云平台开发","阿里云","腾讯云","云计算"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"9000300000000","jobTypeLevelName":"","subJobType":"","subJobTypeLevel":"9000300110000","subJobTypeLevelName":""},"onlineCarHailingExtend":{"gray":false,"promiseGuarantee":""},"onlineCarInfo":[],"other":{"customJobGroup":"DEFAULT","deliveredPreviouslyTip":"","jobKeyword":{"keywords":[]},"jobSkillTags":[],"jobTypeIsBlueCollar":false,"overseasList":[],"pageStyle":0,"positionCommercialLabel":[],"positionHighlight":"","propertyTypeUrl":"","rpoProxyDisplayOrgName":"","urgentRecruitmentUrl":""},"preferredHrInfo":{"icon":"","introduce":"","jumpUrl":"","preferredHr":false},"todayInterview":null,"workLocation":{"address":"工作地点：福田区 · 沙头","addressType":0,"latitude":"22.530146978130276","longitude":"114.02720172657234","positionCityDistrict":"","positionCityDistrictCode":"","positionCityId":"765","positionWorkCity":"","showMap":true,"showMultiAddressesTip":"","staticMapUrl":"https://storage-public.zhaopin.cn/job/share/1785905168901711371/99cd757622e24bf28e02d9bb69558892","streetName":"","tradingArea":"","travelMode":"bus","verifyTheTruthUrl":"","workAddress":"深圳福田博今国际内"}},"proxyWarning":null,"recommender":{"avatar":"","name":"","state":0,"text":"","title":""},"secure":{"