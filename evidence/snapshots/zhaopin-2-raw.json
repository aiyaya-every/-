ow":1,"cityDistrict":"和平","cityId":"531","commercialLabel":[],"commonTrack":{"trackCommercialFeature":"","trackSocialSearchEmergencyFeature":false},"companyId":0,"companyLogo":"https://storage-public.zhaopin.cn/CompanyLogo/20120724/790C4F7A469B487588FFF96B1C30892E.jpg","companyName":"悦信物流(天津)股份有限公司","companyNumber":"CZ120718770","companyRootId":0,"companyScaleTypeTagsNew":[],"companySize":"100-299人","companyUrl":"http://company.zhaopin.com/CC120718770.htm","deliveryPath":"","displayPhoneNumber":false,"distance":0,"distanceFormat":"","distanceText":"","education":"本科","experimentInfo":null,"extend":{"calculatedDistanceInfo":null,"needGray":false},"extensions":null,"featureServer":null,"feedOperation":null,"feedPosition":null,"financingStage":null,"firstPublishTime":"","hasAppliedPosition":false,"industryName":"货运物流","innerBusinessInfo":null,"internshipMonths":0,"isNewPosition":0,"jdCardType":2,"jobDetailData":{"atsAgreement":null,"company":{"base":null,"companyAuditNature":null,"companyComment":null,"companyInterview":null,"jumpDetail":null,"orgBestRanking":null,"orgReliableCompany":null,"other":null,"state":null},"companyProxy":{"companyAddress":"","companyImage":"","companyName":"","companySize":"","entryCompanyTitle":""},"customAttributeInfo":{"platformRemind":"","reportItems":[],"welfareItems":[],"workTimeItems":[]},"debug":{},"experimentInfo":{"blueCollarJobTitleExperimentInfo":null},"featureServer":null,"imSection":null,"internship":[],"live":{"liveItems":[],"liveQuickFocusChecked":0,"liveQuickFocusState":0,"recommendLiveList":[],"state":0},"operationSection":{"topJobBannerArea":null},"partTime":[],"position":{"base":{"deliveryPath":"","education":"本科","educationCode":"","maxSalary":"","minSalary":"","positionId":40889875414,"positionName":"AI应用开发工程师","positionNumber":"CC120718770J40889875414","positionUrl":"","positionWorkingExp":"3-5年","positionWorkingExpCode":"","propertyType":"","recruitNumber":1,"salary":"1.2-1.8万","salaryReal":"","workType":"全职"},"date":{"dateEnd":"","dateStart":"","firstPublishTime":"","positionPublishTime":"","positionUpdateTime":"","positionUpdateTimeText":"9月30日发布"},"desc":{"description":"此岗位企业直招，非外包岗位。\n面试需要线下到面。无法参加现场面试的勿投。\n请仔细阅读以下任职资格、岗位职责及能力要求。\n<div>  一、任职资格：  \n学历：统招本科及以上学历  \n专业：计算机软件或相关专业  \n工作经验：3年及以上Java开发经验  \n  \n</div><div>  二、岗位内容（包括但不限于）：  \n1、参与项目调研、需求分析和设计等工作  \n2、高质量的完成JAVA开发工作，具有良好的编程规范  \n3、参与开发和设计文档的编写  \n4、进行项目应用部署和运行维护  \n  <div>   三、能力要求：   \n1、具有1年以上java语言开发经验（实际编码时间不少于1年），编程基础扎实，熟练掌握常用数据结构和算法。负责过前后端功能开发，熟悉Html5,CSS3,Bootstrap等前端开发技术优先考虑。  </div>  <div>   2、参与产品需求梳理，能够站在用户和业务视角思考问题，主动提出产品优化建议。   \n3、熟悉主流设计软件如pdm，visio等   \n4、有主流数据库如MySQL等的设计、开发经验，熟练掌握SQL，熟悉Redis、MongoDB等非关系型数据库的开发与使用   \n5、熟悉J2EE体系架构，熟悉SpringBoot、MyBatis、SpringCloud等主流开发框架，对OOP , SOA，微服务等理念有深入理解的优先   \n6、熟悉Elasticsearch、Logstash、Kibana等技术和工具的使用，通过异常日志可以快速定位问题，有JVM性能调优经验的优先  </div>7、学习能力强，对 AI Agent、AI 应用开发、低代码/自动化、企业数字化工具等方向有兴趣和实践意愿。能使用 AI 开发工具提升研发效率，能够将 AI 融入需求分析、代码生成、重构、调试、测试、文档编写等完整开发流程。  <div>   8、有独立思考，具备独立解决问题能力，能承受压力，个性成熟稳重，具备良好的逻辑思维和沟通协调能力，工作积极主动认真负责，富于团队精神，具有良好的自学能力和独立解决问题的能力   \n9、具有一定的软件项目管理知识或经验者优先，具有物流行业项目经验者优先  </div>  <div>   关于公司：   \n悦信物流属于BtoB型企业，是海外物流管理&海外仓管理精益化的领航者，致力于供应链的精益化管理，并着力进行海外仓的全球化部署。   \n我们一直秉承着创新者与赋能者的角色，核心企业文化是“悦于心，信于行”。   \n公司总部在天津，分子公司布局在上海、北京、青岛、浙江、安徽、美国、英国等地。   \n2018年成立了海智链科技公司，专为企业提供一体化整合式数字化解决方案。公司具有B2B电商平台、ERP系统、SCM系统、SaaS等应用实施经验，采用主流IT互联网应用技术，具有很强的先进性和延展性。   \n   \n  </div>  <div>   常见问题：   \n1、福利方面：拿到毕业证后缴纳五险一金（基数按照个人实收全额缴纳）、午休一个半小时、国家法定节假日均休息、依照劳动法社会工龄满一年享有带薪年假；   \n2、薪资方面：基本薪资+福利补贴+项目绩效奖金；   \n3、工作时间：弹性工作制，满足一天8h即可。   \n例如9:00-18：00；9:30-18:30；10：00-19:00。   \n12:00-13:30为午休时间，周末双休。   \n4、团队氛围：同事nice，没有办公室政治及加班文化，整体氛围温馨、简单、活泼。   \n5、职业前景：可以得到宽广+稳定的发展平台；并且有专业和管理双向晋升通道。  </div></div>","descriptionHighlight":"","highlightLabels":[],"labels":["JavaScript","Spring","Mybatis","MySQL","Oracle","AI应用","产业互联网平台"],"performanceBonus":"","welfareLabel":[],"welfareTags":[]},"jobType":{"jobType":"","jobTypeLevel":"9000300000000","jobTypeLevelName":"","subJobType":"","subJob